# ---------------------------------------------------------------------------
# Client (Next.js) — copy to .env.local
# ---------------------------------------------------------------------------

# Convex deployment URL, printed by `bunx convex dev`.
NEXT_PUBLIC_CONVEX_URL=https://REPLACE_ME.convex.cloud

# Public origin of the app, used to build shareable invite links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Extra hosts allowed to reach the dev server, comma-separated. Add your machine's
# LAN IP to test from a phone on the same Wi-Fi. Dev only.
# ALLOO_DEV_ORIGINS=127.0.0.1,192.168.1.20

# ---------------------------------------------------------------------------
# Convex deployment — set with `bunx convex env set NAME value`, NOT here.
# Listed for reference; these never belong in a client-side .env file.
# ---------------------------------------------------------------------------

# TURN relay for WebRTC calls. Without it, calls fail behind symmetric NAT and
# corporate firewalls: STUN alone only connects directly reachable peers.
# Credentials are minted per call by convex/turn.ts using coturn's REST scheme,
# so TURN_SECRET must match the relay's `static-auth-secret`.
#
#   bunx convex env set TURN_URLS "turn:turn.example.com:3478,turns:turn.example.com:5349"
#   bunx convex env set TURN_SECRET REPLACE_ME
#   bunx convex env set TURN_TTL_SECONDS 3600     # optional, default 3600
#   bunx convex env set STUN_URLS "stun:stun.example.com:3478"   # optional
