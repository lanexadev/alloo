{
	"name": "alloo",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"engines": {
		"bun": ">=1.2.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "^1.2.0"
		}
	},
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"start": "turbo run start",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit && turbo run typecheck",
		"test": "turbo run test",
		"test:watch": "turbo run test:watch",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"verify": "bun run lint && bun run typecheck && bun run test && bun run build",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,mjs,ts,tsx,mts,json,jsonc,css}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@playwright/test": "^1.62.1",
		"@types/node": "^26.1.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"turbo": "^2.10.8",
		"typescript": "^7.0.2"
	}
}
